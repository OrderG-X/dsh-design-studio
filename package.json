{
  "name": "dsh-design-studio",
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.mjs"
  },
  "description": "Design workbench in the DeepSeek Harness right sidebar: watch web / app / poster screens generate on a canvas with device frames, click an element to send it to the chat, tweak design tokens with sliders, compare versions, extract a brand's design system from a site, turn a design into React / Vue / HTML code checked pixel by pixel, export share-ready images and scan to view on your phone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrderG-X/dsh-design-studio.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "preview",
    "frontend",
    "design"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./auto": "./lib/auto.js",
    "./auto/locale/*.json": "./locale/auto/*.json",
    "./auto/icon": "./icon.svg",
    "./tool": "./lib/tool.js",
    "./tool/locale/*.json": "./locale/tool/*.json",
    "./tool/icon": "./icon.svg",
    "./skill": "./lib/skill.js",
    "./skill/locale/*.json": "./locale/skill/*.json",
    "./skill/icon": "./icon.svg",
    "./preset": "./lib/preset.js",
    "./preset/locale/*.json": "./locale/preset/*.json",
    "./preset/icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
